  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01862e0be5ed2264f8a29db56a3e867c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 160319836}
  speakerNameText: {fileID: 2003964046}
  dialogueText: {fileID: 1252278685}
  dialogueLines:
  - speaker: {fileID: 1805678030}
    speakerName: 'Hare:'
    text: look at me! no one in this forest is faster than me, no one!
    displayTime: 13
    duration: 6
  - speaker: {fileID: 1805678030}
    speakerName: 'Hare:'
    text: Wow there! look who's blocking the path, You're so slow Tortoise, do you
      even move at all?
    displayTime: 33
    duration: 7
  - speaker: {fileID: 330186467}
    speakerName: 'Tortoise:'
    text: I move, Slowly, but surely...
    displayTime: 42
    duration: 3
  - speaker: {fileID: 498476975}
    speakerName: 'Hare:'
    text: 'Slowly!? That''s an understatement, I bet I could race you and still have
      time for a nap before you reach the finish line! '
    displayTime: 47
    duration: 9
  - speaker: {fileID: 330186467}
    speakerName: 'Tortoise:'
    text: Then let's race.
    displayTime: 57
    duration: 2
  - speaker: {fileID: 498476975}
    speakerName: 'Hare:'
    text: You?? Race ME!? Fine. You asked for it.
    displayTime: 62
    duration: 5
  startDelay: 0
  speakerOffset: {x: 0, y: 1.5, z: 0}
